# ===========================================================================
# mcp-notify — configuración
# Copia este archivo a `.env` y rellena los valores, o ejecuta `npm run setup`
# para generarlo de forma interactiva.
# ===========================================================================

# Proveedor de notificaciones activo: "whatsapp" o "telegram"
NOTIFICATION_PROVIDER=telegram

# ---------------------------------------------------------------------------
# WhatsApp (whatsapp-web.js)
# ---------------------------------------------------------------------------
# Número de destino en formato internacional SIN "+" ni espacios.
# Ejemplo para España (+34 612 345 678): 34612345678
WHATSAPP_TARGET_NUMBER=

# (Opcional) Ruta a un Chrome/Chromium ya instalado, por si la descarga
# automática de Puppeteer falla. Ejemplo en Windows:
# PUPPETEER_EXECUTABLE_PATH=C:\Users\TU_USUARIO\.cache\puppeteer\chrome\win64-XXX\chrome-win64\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# ---------------------------------------------------------------------------
# Telegram (Bot API oficial)
# ---------------------------------------------------------------------------
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=

# ID del chat al que enviar los mensajes (ver README para obtenerlo).
TELEGRAM_CHAT_ID=
